# ══════════════════════════════════════════════════════════════════════
# Gigaviz Platform — Environment Variables
# ══════════════════════════════════════════════════════════════════════
# Copy this file to .env.local and fill in the values.
#   cp .env.example .env.local
#
# Legend:
#   🔴 REQUIRED  — App won't start or core features break without it
#   🟡 RECOMMENDED — Important for production but optional in dev
#   ⚪ OPTIONAL  — Feature-specific or has sensible default
# ══════════════════════════════════════════════════════════════════════


# ── 1. Supabase (Core Database & Auth) ────────────────────────────────
# 🔴 Get these from: https://supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=                      # Project URL (e.g. https://abc.supabase.co)
NEXT_PUBLIC_SUPABASE_ANON_KEY=                 # Anon/public key — safe for browser, RLS enforced
SUPABASE_SERVICE_ROLE_KEY=                     # Service role key — bypasses RLS, server-only!
SUPABASE_URL=                                  # ⚪ Alias of NEXT_PUBLIC_SUPABASE_URL (used by KB indexer scripts)
SUPABASE_DB_URL=                               # ⚪ Direct Postgres connection string (migrations/tooling only)
SUPABASE_DB_PASSWORD=                          # ⚪ DB password (scripts that build connection strings manually)
DEFAULT_WORKSPACE_ID=                          # ⚪ Fallback workspace ID for scripts/seeding


# ── 2. App URLs & General ─────────────────────────────────────────────
# 🔴 Base URL of the running application
APP_BASE_URL=http://localhost:3000             # Server-side base URL (auth redirects, emails, webhooks)
NEXT_PUBLIC_APP_URL=http://localhost:3000       # Client-side base URL (invite links, share URLs)
NEXT_PUBLIC_DEMO_UI=false                      # ⚪ Show demo/placeholder UI elements
NEXT_PUBLIC_INBOX_SLA_HOURS=24                 # ⚪ Default SLA target for inbox response time (hours)
NEXT_PUBLIC_SALES_WA=                          # ⚪ WhatsApp number shown on sales/contact pages


# ── 3. Access Control & Feature Toggles ───────────────────────────────
# 🟡 Comma-separated email addresses for access levels
ADMIN_EMAILS=                                  # Admin users (can access /admin/* routes)
ADMIN_EMAIL=                                   # ⚪ Singular alias fallback for ADMIN_EMAILS
GIGAVIZ_OWNER_EMAILS=                          # Platform owners (can access /ops/* and claim admin)
DEV_FULL_ACCESS_EMAILS=                        # Dev accounts that bypass entitlement checks
DEV_ADMIN_EMAILS=                              # Dev accounts shown in ops claim page
DEV_ADMIN_EMAIL=                               # ⚪ Singular alias fallback for DEV_ADMIN_EMAILS
OPS_ENABLED=0                                  # Enable /ops console (set to 1 in production)

# ⚪ Feature flags (boolean toggles)
SUPERVISOR_TAKEOVER_ENABLED=false              # Allow supervisors to take over inbox threads
SKILL_ROUTING_ENABLED=false                    # Enable skill-based routing for inbox
MERGE_ENABLED=false                            # Enable CRM contact merge feature
ENABLE_BILLING_TEST_MODE=false                 # Allow test billing/token operations
ENABLE_META_EVENTS_SEND=false                  # Enable sending CAPI events to Meta


# ── 4. Email (Resend) ─────────────────────────────────────────────────
# 🟡 Get from: https://resend.com → API Keys
RESEND_API_KEY=                                # Resend API key for transactional emails
RESEND_FROM_AUTH=                              # From address for auth emails (e.g. noreply@gigaviz.com)
RESEND_FROM_CONTACT=                           # From address for contact form (e.g. contact@gigaviz.com)
CONTACT_RECIPIENT_EMAIL=                       # Recipient for contact form submissions


# ── 5. Analytics & SEO ────────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=                             # ⚪ Google Analytics 4 measurement ID (G-XXXXXXXXXX)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=          # ⚪ Google Search Console verification meta tag


# ── 6. Sentry Error Monitoring ────────────────────────────────────────
# 🟡 Get from: https://sentry.io → Project Settings
NEXT_PUBLIC_SENTRY_DSN=                        # Sentry DSN (client + server + edge)
SENTRY_ORG=                                    # Sentry organization slug (for source map uploads)
SENTRY_PROJECT=                                # Sentry project slug
SENTRY_AUTH_TOKEN=                             # Sentry auth token (CI source map uploads only)


# ── 7. Logging ────────────────────────────────────────────────────────
LOG_LEVEL=info                                 # ⚪ Log verbosity: debug | info | warn | error


# ── 8. Meta OAuth / Graph API ─────────────────────────────────────────
# 🔴 (for Meta Hub) Get from: https://developers.facebook.com → App Dashboard
META_APP_ID=                                   # Facebook App ID (OAuth login, webhook verification)
META_APP_SECRET=                               # Facebook App Secret (OAuth token exchange, webhook signature)
META_BUSINESS_APP_ID=                          # ⚪ Business App ID (fallback for META_APP_ID in subscribed-apps)
META_OAUTH_REDIRECT_URI=https://gigaviz.com/api/meta/oauth/callback  # OAuth callback URL
META_GRAPH_API_VERSION=v21.0                   # Graph API version for all Meta services
META_GRAPH_VERSION=v21.0                       # ⚪ Alias for META_GRAPH_API_VERSION
WA_GRAPH_VERSION=v22.0                         # ⚪ WhatsApp-specific Graph API version (overrides META_GRAPH_VERSION)
META_SYSTEM_USER_TOKEN=                        # ⚪ System User token for server-to-server Graph API calls
META_WHATSAPP_ACCESS_TOKEN=                    # ⚪ Alias — WhatsApp access token for Graph API

# 🟡 Client-side Meta SDK configuration
NEXT_PUBLIC_META_APP_ID=                       # Facebook App ID exposed to browser (Embedded Signup SDK)
NEXT_PUBLIC_META_CONFIG_ID=                    # WhatsApp Embedded Signup config ID
NEXT_PUBLIC_META_SOLUTION_ID=                  # WhatsApp Solution Partner ID


# ── 9. Meta Hub Toggles ───────────────────────────────────────────────
# ⚪ Enable/disable individual Meta Hub channels
META_HUB_WA_ENABLED=true                      # WhatsApp channel
META_HUB_IG_ENABLED=false                      # Instagram channel
META_HUB_MS_ENABLED=false                      # Messenger channel
META_HUB_ADS_ENABLED=false                     # Ads Manager / CAPI
META_HUB_INSIGHTS_ENABLED=false                # Insights dashboard
META_HUB_WA_TEST_DRY_RUN=false                # Dry-run WhatsApp test sends (no actual delivery)
META_HUB_ALLOW_PENDING_TEST=false              # Allow testing templates in pending-approval status


# ── 10. Webhook Verification ──────────────────────────────────────────
# 🔴 (for Meta Hub) Token used to verify Meta webhook subscriptions
META_WEBHOOK_VERIFY_TOKEN=                     # Primary verify token (used by all Meta webhooks)
WA_WEBHOOK_VERIFY_TOKEN=                       # ⚪ Alias for META_WEBHOOK_VERIFY_TOKEN
WEBHOOK_VERIFY_TOKEN=                          # ⚪ Alias for META_WEBHOOK_VERIFY_TOKEN
WEBHOOK_SECRET=                                # 🟡 Bearer secret for generic/internal webhook endpoints
BILLING_WEBHOOK_SECRET=                        # ⚪ Dedicated bearer secret for /api/billing/webhook


# ── 11. WhatsApp Cloud API ────────────────────────────────────────────
# 🔴 (for WhatsApp messaging) Get from: Meta Business Suite → WhatsApp
WA_ACCESS_TOKEN=                               # WhatsApp Cloud API access token (send messages)
WA_CLOUD_API_TOKEN=                            # ⚪ Alias for WA_ACCESS_TOKEN
WA_CLOUD_API_SYSTEM_USER_TOKEN=                # ⚪ System User token (longer-lived, recommended for production)
WHATSAPP_ACCESS_TOKEN=                         # ⚪ Legacy alias for WA_ACCESS_TOKEN
WA_WABA_ID=                                   # WhatsApp Business Account ID
WA_PHONE_NUMBER_ID=                            # WhatsApp phone number ID (sender)
WA_ADMIN_PHONE=                                # ⚪ Admin phone number for test/alert messages


# ── 12. Attachments (Supabase Storage) ────────────────────────────────
ATTACHMENTS_BUCKET=inbox-attachments           # ⚪ Supabase Storage bucket name for inbox attachments
ATTACHMENTS_SIGNED_URL_TTL=600                 # ⚪ Signed URL expiry in seconds (default: 10 minutes)


# ── 13. Rate Limit & Worker Configuration ─────────────────────────────
ENABLE_WA_SEND=false                           # Master switch: enable outbox worker to send WhatsApp messages
RATE_CAP_PER_MIN=20                            # ⚪ Max messages per minute per workspace
RATE_DELAY_MIN_MS=800                          # ⚪ Min delay between sends (ms)
RATE_DELAY_MAX_MS=2200                         # ⚪ Max delay between sends (ms)
WORKER_ID=                                     # ⚪ Unique worker instance ID (for multi-worker setups)
WORKER_BATCH_SIZE=20                           # ⚪ Messages to claim per poll cycle
WORKER_MAX_ATTEMPTS=5                          # ⚪ Max retry attempts before marking failed
WORKER_POLL_INTERVAL_MS=2000                   # ⚪ Poll interval in ms (default: 2 seconds)


# ── 14. Cron Jobs ─────────────────────────────────────────────────────
CRON_SECRET=                                   # 🟡 Shared secret for /api/cron/* (generate: openssl rand -base64 32)
VERCEL_CRON_SECRET=                            # ⚪ Auto-set by Vercel (alternative to CRON_SECRET)
WORKER_HEALTH_SECRET=                          # ⚪ Optional dedicated secret for /api/health/workers (fallback: CRON_SECRET/WEBHOOK_SECRET)


# ── 15. AI / Helper Providers (server-only) ───────────────────────────
# 🔴 (for Helper module) At least one LLM key required
OPENAI_API_KEY=                                # OpenAI key — used for embeddings + chat (required for RAG)
ANTHROPIC_API_KEY=                             # ⚪ Anthropic Claude key (alternative chat provider)
GEMINI_API_KEY=                                # ⚪ Google Gemini key (alternative chat provider)
OLLAMA_URL=http://127.0.0.1:11434             # ⚪ Local Ollama server URL (self-hosted LLM)
OLLAMA_MODEL=gemma3:4b                         # ⚪ Default Ollama model

# ⚪ NLP / Sentiment analysis (external service)
NLP_API_URL=                                   # NLP service endpoint
NLP_SENTIMENT_URL=                             # Sentiment analysis endpoint
NLP_API_KEY=                                   # NLP service API key
NLP_SENTIMENT_KEY=                             # Sentiment service API key

# ⚪ n8n workflow integration
N8N_WEBHOOK_URL=                               # n8n webhook trigger URL
N8N_SHARED_SECRET=                             # n8n shared secret for auth


# ── 16. Knowledge Base / RAG ──────────────────────────────────────────
# ⚪ Configuration for KB indexing (scripts/kb-index.ts)
KB_ALLOWED_DOMAINS=                            # Comma-separated domains to crawl
KB_SITEMAP_URLS=                               # Sitemap URLs to discover pages
KB_SEED_URLS=                                  # Starting URLs for web crawler
KB_MAX_PAGES_PER_RUN=200                       # Max pages to index per run
KB_USER_AGENT=GigavizBot/1.0                   # User-Agent string for crawler
KB_EMBED_PROVIDER=openai                       # Embedding provider: openai | ollama
KB_EMBED_MODEL=text-embedding-3-small          # Embedding model name
KB_EMBED_DIM=1536                              # Embedding vector dimensions
KB_CHUNK_MAX_CHARS=2200                        # Max characters per chunk
KB_CHUNK_OVERLAP_CHARS=200                     # Overlap between chunks
KB_BLOCKED_PATH_PREFIXES=/api,/auth,/admin,/dashboard,/settings,/billing,/workspace,/tokens
KB_BLOCKED_QUERY_KEYS=token,code,key,secret,session,auth


# ── 17. Ops Alerting ──────────────────────────────────────────────────
# ⚪ Webhook URLs for operational alerts (health, impersonation, suspension)
OPS_SLACK_WEBHOOK_URL=                         # Slack Incoming Webhook URL
OPS_DISCORD_WEBHOOK_URL=                       # Discord Webhook URL
OPS_ALERT_WEBHOOK_URL=                         # Generic webhook URL (any service)


# ── 18. Upstash Redis ─────────────────────────────────────────────────
# 🟡 Get from: https://console.upstash.com → Redis Database
UPSTASH_REDIS_REST_URL=                        # Upstash Redis REST URL (for rate limiting)
UPSTASH_REDIS_REST_TOKEN=                      # Upstash Redis REST token


# ── 19. Midtrans (Payment Gateway — Indonesia) ───────────────────────
# 🟡 Get from: https://dashboard.midtrans.com → Settings → Access Keys
MIDTRANS_SERVER_KEY=                           # Server key (SB-Mid-server-... for sandbox, Mid-server-... for prod)
MIDTRANS_CLIENT_KEY=                           # Client key (SB-Mid-client-... for sandbox, Mid-client-... for prod)
MIDTRANS_IS_PRODUCTION=false                   # Set to "true" for production (uses app.midtrans.com instead of sandbox)
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=               # Same as MIDTRANS_CLIENT_KEY (exposed for Snap.js in browser)
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=false       # Same as MIDTRANS_IS_PRODUCTION (exposed for Snap.js URL)
NEXT_PUBLIC_MIDTRANS_ENABLED=                  # Set to "1" to enable Midtrans checkout buttons

# ── 20. Xendit (Payment Gateway — International + SEA) ───────────────
# 🟡 Get from: https://dashboard.xendit.co → Settings → API Keys
XENDIT_SECRET_KEY=                             # Secret API key (xnd_development_... or xnd_production_...)
XENDIT_WEBHOOK_TOKEN=                          # Webhook verification token (from Dashboard → Settings → Callbacks)
NEXT_PUBLIC_XENDIT_ENABLED=                    # Set to "1" to enable Xendit checkout buttons


# ── 21. Scripts / Tooling (not needed at runtime) ─────────────────────
# ⚪ Used only by scripts in scripts/ folder
# AUDIT_BASE_URL=http://localhost:3000         # Base URL for audit/nav-url scanning script
# DATABASE_URL=                                # Raw Postgres URL for migration scripts


# ── 21. Testing ───────────────────────────────────────────────────────
# ⚪ Only set in test environments
# SKIP_ENV_VALIDATION=true                     # Skip Zod env validation (CI/test only)


# ── Legacy / unused (commented out for reference) ─────────────────────
# WA_VERIFY_TOKEN=                             # Replaced by META_WEBHOOK_VERIFY_TOKEN
# META_BUSINESS_ID=                            # Not referenced in code
# BILLING_PROVIDER=manual
# XENDIT_SECRET_KEY=                           # Not used — using Midtrans instead
# KB_ADMIN_REINDEX_TOKEN=
# KB_INDEX_CRON_ENABLED=true
